// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email            String    @unique
  nombre           String
  sector           String
  tarjetaUltimos4  String
  password         String?
  isAdmin          Boolean   @default(false)
  isCodeVerified   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  expenses         Expense[]
  cardSummaries    CardSummary[]
  tarjetas         Tarjeta[]
  recurringExpenses RecurringExpense[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]

  @@map("users")
}

model Expense {
  id                 String    @id @default(cuid())
  fechaGasto         DateTime
  fechaCarga         DateTime  @default(now())
  motivo             String
  detalle            String
  monto              Float
  montoEnPesos       Float    @default(0)
  importeTotal       Float
  moneda             String
  tipoCambio         Float?
  canalPago          String    // "web", "local", "otro"
  canalPagoDetalle   String?
  tieneCuotas        Boolean   @default(false)
  cantidadCuotas     Int?
  documento          String?   // Base64 del archivo o URL
  documentoNombre    String?
  documentoTipo      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relación con el usuario
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tarjeta utilizada (opcional para gastos anteriores)
  tarjetaId          String?
  tarjeta            Tarjeta?  @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)

  // Plantilla de gasto recurrente que generó este gasto (si aplica)
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  // Unidad de negocio a la que se destina el gasto (puede ser distinta a la unidad de la tarjeta)
  unidadDestinoId    String?
  unidadDestino      Unidad?   @relation(fields: [unidadDestinoId], references: [id], onDelete: SetNull)

  // true cuando lo cargó el conector MCP (ej: Claude leyendo una factura) y
  // todavía no lo confirmó/editó un humano. No aparece en las tablas normales.
  pendienteRevision  Boolean   @default(false)

  @@map("expenses")
}

model Tarjeta {
  id          String    @id @default(cuid())
  ultimos4    String
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  cardSummaries CardSummary[]
  recurringExpenses RecurringExpense[]

  // Unidad de negocio a la que el administrador asignó esta tarjeta
  unidadId      String?
  unidad        Unidad?       @relation(fields: [unidadId], references: [id], onDelete: SetNull)

  @@map("tarjetas")
}

model Unidad {
  id          String    @id @default(cuid())
  nombre      String    @unique
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tarjetas    Tarjeta[]
  gastosDestino Expense[]

  @@map("unidades")
}

model RecurringExpense {
  id                     String    @id @default(cuid())
  motivo                 String
  detalle                String
  monto                  Float
  moneda                 String
  tipoCambio             Float?
  canalPago              String    // "web", "local", "otro"
  canalPagoDetalle       String?
  diaDelMes              Int       // Día del mes (1-28) en que se genera el gasto
  activo                 Boolean   @default(true)
  fechaInicio            DateTime  @default(now())
  fechaFin               DateTime?
  ultimoPeriodoGenerado  String?   // Último período ya generado, formato "YYYY-MM"
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tarjetaId              String?
  tarjeta                Tarjeta?  @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)

  expenses               Expense[]

  @@map("recurring_expenses")
}

model CardSummary {
  id                 String    @id @default(cuid())
  periodo            String    // Formato: "YYYY-MM" (ej: "2024-12")
  archivo            String    // Base64 del PDF/imagen del resumen
  archivoNombre      String
  archivoTipo        String
  descripcion        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relación con el usuario
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tarjeta a la que pertenece el resumen (opcional)
  tarjetaId          String?
  tarjeta            Tarjeta?  @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)

  @@map("card_summaries")
  @@index([userId, periodo])
}

// ---- OAuth para el conector MCP (Claude Pro / claude.ai lee facturas y las
// carga vía /api/mcp). Implementa un authorization-code flow con PKCE +
// registro dinámico de clientes (RFC 7591), que es lo que claude.ai espera
// al agregar un conector remoto personalizado. ----

model OAuthClient {
  id                      String    @id @default(cuid())
  clientId                String    @unique
  clientSecret            String?
  clientName              String?
  redirectUris            String[]
  createdAt               DateTime  @default(now())

  authorizationCodes      OAuthAuthorizationCode[]
  accessTokens            OAuthAccessToken[]
  refreshTokens           OAuthRefreshToken[]

  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  code                String    @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String?
  used                Boolean   @default(false)
  expiresAt           DateTime
  createdAt           DateTime  @default(now())

  @@map("oauth_authorization_codes")
}

model OAuthAccessToken {
  id          String    @id @default(cuid())
  token       String    @unique
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id          String    @id @default(cuid())
  token       String    @unique
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("oauth_refresh_tokens")
}
